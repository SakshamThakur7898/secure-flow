# selenium_tests/.env.example
#
# Copy this file to ".env" in this same folder to configure the suite
# without exporting environment variables every time. ".env" itself is
# git-ignored (see the project's root .gitignore) so it's safe to put
# machine-specific values in it.
#
# Nothing below is a real secret -- these are SecureFlow's own
# documented, public, development-only demo credentials (see the main
# project's README.md). Still centralized here rather than hard-coded in
# test files, so they're easy to point at a different environment.

# Test against your deployed Render URL:
# SELENIUM_BASE_URL=https://your-secureflow-app.onrender.com
# Or leave unset / point at a local `npm start`:
SELENIUM_BASE_URL=http://127.0.0.1:4000

# true = run Chrome invisibly (e.g. CI). false = open a real visible
# browser window, for demoing the practical live.
SELENIUM_HEADLESS=false

# Uncomment to override the seeded demo accounts (e.g. if you reset your
# deployed database with different credentials):
# SELENIUM_ADMIN_USERNAME=admin
# SELENIUM_ADMIN_PASSWORD=Admin@123
# SELENIUM_MANAGER_USERNAME=manager
# SELENIUM_MANAGER_PASSWORD=Manager@123
# SELENIUM_EMPLOYEE_USERNAME=employee
# SELENIUM_EMPLOYEE_PASSWORD=Employee@123
